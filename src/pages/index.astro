---
import homepage from '../data/homepage.json';

const dogFiles = import.meta.glob('../data/dogs/*.json', { eager: true });

const dogs = Object.values(dogFiles).map((file: any) => file.default);

const featuredDogs = dogs
  .filter((dog) => dog.featured && dog.status === 'Available')
  .slice(0, 3);

const campaignSections = [homepage.campaign1, homepage.campaign2].filter(
  (campaign) => campaign?.enabled
);
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>J-Lo's Animal Rescue & Sanctuary</title>
	</head>

	<body>
		<header>
			<div class="logo-wrap">
				<img src="/images/J-lo logo.png" alt="J-Lo's Animal Rescue & Sanctuary" />
			</div>

			<nav>
				<a href="/">Home</a>
<a href="/adopt">Adopt</a>
				<a href="#mission">{homepage.footer.missionLinkText}</a>
				<a href="#involved">{homepage.footer.involvedLinkText}</a>
				<a href="#faq">FAQs</a>
				<a href="#contact">{homepage.footer.contactLinkText}</a>
			</nav>

<a class="donate" href={homepage.hero.donateButtonLink} target="_blank" rel="noopener noreferrer">{homepage.hero.donateButtonText}</a>		</header>

		<main>
			<section class="hero">
				<div class="overlay"></div>

				<div class="hero-content">
					<h1>
						{homepage.hero.headlineLine1}<br />
						{homepage.hero.headlineLine2}<br />
						{homepage.hero.headlineLine3}<br />
						{homepage.hero.headlineLine4} <span>♥</span>
					</h1>

					<p>
						{homepage.hero.subheadlineLine1}<br />
						{homepage.hero.subheadlineLine2}
					</p>

					<div class="hero-buttons">
						<a class="primary-button" href={homepage.hero.primaryButtonLink}>{homepage.hero.primaryButtonText}</a>
						<a class="donate" href={homepage.hero.donateButtonLink} target="_blank" rel="noopener noreferrer">{homepage.hero.donateButtonText}</a>
					</div>
				</div>
			</section>

			<section class="dogs-section" id="dogs">
				<div class="section-heading">
					<p class="eyebrow">{homepage.featuredDogs.eyebrow}</p>
					<h2>{homepage.featuredDogs.title}</h2>
					<p>{homepage.featuredDogs.description}</p>
				</div>

				<div class="dog-grid">
	{featuredDogs.map((dog) => (
		<article class="dog-card">
			<div class="dog-photo">
				{dog.image ? (
					<img src={dog.image} alt={dog.name} />
				) : (
					<span>Replace Dog Photo</span>
				)}
			</div>

			<div class="dog-info">
				<h3>{dog.name}</h3>
				<p>{dog.breed}</p>

				<div class="tags">
					<span>{dog.age}</span>
					<span>{dog.sex}</span>
					<span>{dog.size}</span>
				</div>

				<a href={`/dogs/${dog.slug}`}>Meet {dog.name} →</a>
			</div>
		</article>
	))}
</div>
			</section>

			<section class="mission-section" id="mission">
				<div class="mission-inner">
					<div class="mission-photo">
						<img
							src="/images/jessica-lopez.jpg"
							alt="Jessica Lopez with a rescue dog"
						/>
					</div>

					<div class="mission-content">
						<p class="eyebrow">{homepage.mission.eyebrow}</p>
						<h2>{homepage.mission.title}</h2>

						<div class="mission-copy">
							<p>{homepage.mission.paragraph1}</p>
							<p>{homepage.mission.paragraph2}</p>
							<p>{homepage.mission.paragraph3}</p>
						</div>
					</div>
				</div>
			</section>

			<section class="involved-section" id="involved">
				<div class="section-heading">
					<p class="eyebrow">{homepage.involved.eyebrow}</p>
					<h2>{homepage.involved.title}</h2>
				</div>

				<div class="involved-grid">
					<div>
						<h3>{homepage.involved.adoptTitle}</h3>
						<p>{homepage.involved.adoptDescription}</p>
					</div>

					<div>
						<h3>{homepage.involved.donateTitle}</h3>
						<p>{homepage.involved.donateDescription}</p>
					</div>

					<div>
						<h3>{homepage.involved.volunteerTitle}</h3>
						<p>{homepage.involved.volunteerDescription}</p>
					</div>
				</div>
			</section>

			{campaignSections.map((campaign) => (
				<section class="campaign-section">
					<div class="campaign-inner">
						{campaign.image && (
							<div class="campaign-image">
								<img src={campaign.image} alt={campaign.title || 'Campaign'} />
							</div>
						)}

						<div class="campaign-content">
							<p class="eyebrow">Featured Campaign</p>
							{campaign.title && <h2>{campaign.title}</h2>}
							{campaign.description && <p>{campaign.description}</p>}

							{campaign.embedUrl && (
								<div class="campaign-embed">
									<iframe
										src={campaign.embedUrl}
										title={campaign.title || 'Campaign'}
										loading="lazy"
									></iframe>
								</div>
							)}

							{campaign.buttonText && campaign.buttonLink && (
								<a
									class="primary-button campaign-button"
									href={campaign.buttonLink}
									target="_blank"
									rel="noopener noreferrer"
								>
									{campaign.buttonText}
								</a>
							)}
						</div>
					</div>
				</section>
			))}

			<section class="donate-section" id="donate">
				<div>
					<p class="eyebrow light-eyebrow">{homepage.donation.eyebrow}</p>
					<h2>{homepage.donation.title}</h2>
					<p>{homepage.donation.description}</p>
				</div>

				<a
					href={homepage.donation.buttonLink}
					class="white-button"
					target="_blank"
					rel="noopener noreferrer"
				>
					{homepage.donation.buttonText}
				</a>
			</section>

			<section class="faq-section" id="faq">
				<div class="section-heading">
					<p class="eyebrow">{homepage.faqs.eyebrow}</p>
					<h2>{homepage.faqs.title}</h2>
				</div>

				<div class="faq-list">
					<details>
						<summary>{homepage.faqs.question1}</summary>
						<p>{homepage.faqs.answer1}</p>
					</details>

					<details>
						<summary>{homepage.faqs.question2}</summary>
						<p>{homepage.faqs.answer2}</p>
					</details>

					<details>
						<summary>{homepage.faqs.question3}</summary>
						<p>{homepage.faqs.answer3}</p>
					</details>
				</div>
			</section>

			<section class="contact-section" id="contact">
				<div class="section-heading">
					<p class="eyebrow">{homepage.contact.eyebrow}</p>
					<h2>{homepage.contact.title}</h2>
				</div>

				<form>
					<input type="text" placeholder={homepage.contact.namePlaceholder} />
					<input type="email" placeholder={homepage.contact.emailPlaceholder} />
					<input type="text" placeholder={homepage.contact.dogPlaceholder} />
					<textarea placeholder={homepage.contact.messagePlaceholder}></textarea>
					<button type="submit">{homepage.contact.buttonText}</button>
				</form>
			</section>

			<section class="scribble-section">
				<img src="/images/dog-scribble.png" alt="" />
			</section>
		</main>

		<footer>
			<div class="footer-logo">
				<img src="/images/J-lo logo.png" alt="J-Lo's Animal Rescue & Sanctuary" />
			</div>

			<div>
				<p>{homepage.footer.location}</p>
				<p>{homepage.footer.tagline}</p>
			</div>

			<div>
				<a href="/adopt">{homepage.footer.dogsLinkText}</a>
				<a href="#mission">Our Mission</a>
				<a href="#involved">Get Involved</a>
				<a href="#contact">Contact</a>
			</div>
		</footer>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		font-family: Arial, Helvetica, sans-serif;
		background: #faf7f2;
		color: #191414;
	}

	header {
		min-height: 96px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 10px 5%;
		background: #faf7f2;
		gap: 30px;
	}

	.logo-wrap img {
		width: auto;
		height: 72px;
		max-width: 270px;
		object-fit: contain;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 30px;
	}

	nav a {
		color: #191414;
		text-decoration: none;
		font-size: 14px;
		font-weight: 700;
	}

	.donate {
		background: #c9252d;
		color: white;
		text-decoration: none;
		text-transform: uppercase;
		font-weight: 800;
		padding: 15px 24px;
		border-radius: 999px;
		white-space: nowrap;
	}

	.hero {
		position: relative;
		min-height: 650px;
		display: flex;
		align-items: center;
		padding: 70px 6%;
		background-image: url('/images/Hero-dogs.jpg');
		background-size: cover;
		background-position: center;
	}

	.overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			90deg,
			rgba(0,0,0,.78) 0%,
			rgba(0,0,0,.50) 45%,
			rgba(0,0,0,.08) 100%
		);
	}

	.hero-content {
		position: relative;
		z-index: 1;
		max-width: 650px;
		color: white;
	}

	h1 {
		margin: 0;
		font-size: clamp(52px, 6vw, 84px);
		line-height: .98;
		letter-spacing: -3px;
	}

	h1 span {
		color: #d72a31;
	}

	.hero-content > p {
		font-size: 21px;
		line-height: 1.5;
		margin: 28px 0;
	}

	.hero-buttons {
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
	}

	.primary-button,
	.secondary-button,
	.white-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding: 15px 25px;
		border-radius: 999px;
		text-decoration: none;
		text-transform: uppercase;
		font-size: 13px;
		font-weight: 800;
		line-height: 1;
		letter-spacing: .4px;
		white-space: nowrap;
	}

	.primary-button {
		background: #c9252d;
		color: white;
	}

	.secondary-button {
		border: 2px solid white;
		color: white;
	}

	.dogs-section,
	.involved-section,
	.faq-section,
	.contact-section {
		padding: 100px 6%;
	}

	.section-heading {
		max-width: 760px;
		margin: 0 auto 50px;
		text-align: center;
	}

	.eyebrow {
		margin: 0 0 12px;
		color: #c9252d;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	.section-heading h2,
	.mission-section h2,
	.donate-section h2,
	.campaign-section h2 {
		margin: 0;
		font-size: clamp(40px, 5vw, 64px);
		line-height: 1;
		letter-spacing: -2px;
	}

	.section-heading > p:last-child {
		font-size: 18px;
		color: #665d57;
		line-height: 1.6;
	}

	.dog-grid {
		max-width: 1200px;
		margin: auto;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.dog-card {
		overflow: hidden;
		background: white;
		border-radius: 24px;
		border: 1px solid rgba(25,20,20,.08);
		box-shadow: 0 18px 45px rgba(30,20,18,.07);
	}

	.dog-photo {
		aspect-ratio: 4 / 3;
		display: grid;
		place-items: center;
		background: #e9e2da;
		color: #81766e;
		font-weight: 700;
	}

	.dog-info {
		padding: 22px;
	}

	.dog-info h3 {
		margin: 0;
		font-size: 30px;
	}

	.dog-info > p {
		margin: 5px 0 0;
		color: #665d57;
	}

	.tags {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
		margin: 18px 0;
	}

	.tags span {
		background: #f3ece4;
		padding: 7px 10px;
		border-radius: 999px;
		font-size: 12px;
		font-weight: 700;
	}

	.dog-info a {
		color: #c9252d;
		text-decoration: none;
		text-transform: uppercase;
		font-size: 13px;
		font-weight: 800;
	}

	.mission-section {
		padding: 100px 6%;
		background: #f3ece4;
	}

	.mission-inner {
		max-width: 1200px;
		margin: auto;
		display: grid;
		grid-template-columns: minmax(320px, .9fr) 1.1fr;
		gap: 70px;
		align-items: center;
	}

	.mission-photo {
		overflow: hidden;
		border-radius: 28px;
		box-shadow: 0 20px 55px rgba(30,20,18,.12);
	}

	.mission-photo img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: center;
	}

	.mission-content h2 {
		margin-bottom: 28px;
	}

	.mission-copy {
		font-size: 18px;
		line-height: 1.75;
		color: #4f4742;
	}

	.mission-copy p:first-child {
		margin-top: 0;
	}

	.mission-copy p:last-child {
		margin-bottom: 0;
	}

	.involved-grid {
		max-width: 1200px;
		margin: auto;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.involved-grid > div {
		padding: 28px;
		background: white;
		border-radius: 22px;
		box-shadow: 0 15px 40px rgba(30,20,18,.06);
	}

	.involved-grid h3 {
		font-size: 25px;
		margin-top: 0;
	}

	.involved-grid p {
		color: #665d57;
		line-height: 1.6;
	}

	.campaign-section {
		padding: 20px 6% 80px;
	}

	.campaign-inner {
		max-width: 1200px;
		margin: auto;
		display: grid;
		grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
		gap: 48px;
		align-items: center;
		padding: 38px;
		background: white;
		border: 1px solid rgba(25,20,20,.08);
		border-radius: 28px;
		box-shadow: 0 18px 45px rgba(30,20,18,.07);
	}

	.campaign-image {
		overflow: hidden;
		border-radius: 22px;
		background: #f3ece4;
	}

	.campaign-image img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.campaign-content > p:not(.eyebrow) {
		font-size: 18px;
		line-height: 1.7;
		color: #665d57;
	}

	.campaign-button {
		margin-top: 10px;
	}

	.campaign-embed {
		margin-top: 24px;
		overflow: hidden;
		border-radius: 18px;
		background: #f3ece4;
	}

	.campaign-embed iframe {
		display: block;
		width: 100%;
		min-height: 520px;
		border: 0;
	}

	.donate-section {
		width: min(1200px, calc(100% - 48px));
		margin: 90px auto;
		padding: 55px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 40px;
		background: #c9252d;
		color: white;
		border-radius: 30px;
	}

	.donate-section > div {
		max-width: 760px;
	}

	.donate-section > div > p:last-child {
		font-size: 18px;
		line-height: 1.6;
		color: rgba(255,255,255,.85);
	}

	.light-eyebrow {
		color: white;
		opacity: .8;
	}

	.white-button {
		background: white;
		color: #c9252d;
		white-space: nowrap;
	}

	.faq-list {
		max-width: 900px;
		margin: auto;
	}

	details {
		padding: 22px 0;
		border-bottom: 1px solid rgba(25,20,20,.14);
	}

	summary {
		cursor: pointer;
		font-size: 21px;
		font-weight: 800;
	}

	details p {
		color: #665d57;
		line-height: 1.65;
	}

	form {
		max-width: 760px;
		margin: auto;
		display: grid;
		gap: 15px;
	}

	input,
	textarea {
		width: 100%;
		padding: 15px;
		border: 1px solid rgba(25,20,20,.16);
		border-radius: 14px;
		font: inherit;
		background: white;
	}

	textarea {
		min-height: 150px;
		resize: vertical;
	}

	button {
		border: 0;
		background: #c9252d;
		color: white;
		padding: 15px 24px;
		border-radius: 999px;
		text-transform: uppercase;
		font-weight: 800;
		cursor: pointer;
	}

	.scribble-section {
		min-height: 180px;
		position: relative;
	}

	.scribble-section img {
		position: absolute;
		left: 5%;
		bottom: 0;
		width: 190px;
	}

	footer {
		padding: 55px 6%;
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		align-items: center;
		gap: 40px;
		background: #191414;
		color: white;
	}

	.footer-logo img {
		width: 220px;
		filter: brightness(0) invert(1);
	}

	footer p {
		color: rgba(255,255,255,.65);
		line-height: 1.6;
	}

	footer div:last-child {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	footer a {
		color: rgba(255,255,255,.75);
		text-decoration: none;
	}

	@media (max-width: 900px) {
		nav {
			display: none;
		}

		.dog-grid,
		.involved-grid {
			grid-template-columns: 1fr 1fr;
		}

		.mission-inner,
		.campaign-inner {
			grid-template-columns: 1fr;
			gap: 35px;
		}

		.mission-photo {
			max-width: 620px;
		}

		.donate-section {
			flex-direction: column;
			align-items: flex-start;
		}

		footer {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 650px) {
		header {
			padding: 10px 20px;
		}

		.logo-wrap img {
			height: 55px;
			max-width: 190px;
		}

		.donate {
			padding: 12px 16px;
			font-size: 12px;
		}

		.hero {
			min-height: 580px;
			padding: 60px 24px;
			background-position: 58% center;
		}

		h1 {
			font-size: 48px;
		}

		.dog-grid,
		.involved-grid {
			grid-template-columns: 1fr;
		}

		.dogs-section,
		.involved-section,
		.faq-section,
		.contact-section,
		.mission-section,
		.campaign-section {
			padding: 70px 24px;
		}

		.donate-section {
			width: calc(100% - 34px);
			padding: 34px 26px;
		}

		.campaign-inner {
			padding: 26px;
		}

		.campaign-embed iframe {
			min-height: 420px;
		}

		.scribble-section img {
			width: 130px;
		}
	}
</style>