---
import BaseLayout from '../layouts/BaseLayout.astro';
import DogCard from '../components/DogCard.astro';
import dogs from '../data/dogs.json';
const featuredDogs = dogs.slice(0,3);
---
<BaseLayout>
  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-inner">
      <div class="hero-copy">
        <h1>From Neglected<br/>to Nourished.<br/>From Alone<br/>to Adored. <span>♥</span></h1>
        <p class="hero-sub">A safe haven. A second chance.<br/>A forever home.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/adopt">Meet the Dogs</a>
          <a class="btn btn-outline light" href="/donate">Help Us Save More</a>
        </div>
      </div>
    </div>
  </section>

  <section class="dogs-home">
    <div class="container">
      <div class="center-heading">
        <p class="eyebrow">Find your new best friend</p>
        <h2 class="section-title">Dogs Looking for Love</h2>
        <p class="section-copy">Every dog here is waiting for the right family. Maybe that's you.</p>
      </div>
      <div class="dogs-grid">{featuredDogs.map((dog)=><DogCard dog={dog}/>)}</div>
      <div class="center-action"><a class="btn btn-primary" href="/adopt">View All Dogs</a></div>
    </div>
  </section>

  <section class="mission-home">
    <div class="container mission-grid">
      <div><p class="eyebrow">Our Mission</p><h2 class="section-title">A life-saving dream made real.</h2></div>
      <div class="mission-copy">
        <p>Founded by Jessica Lopez, a wife and mother of three, J-Lo Animal Rescue is a heartfelt life-long dream of Jessica’s that has blossomed into a life-saving reality in Albany, Ga.</p>
        <p>What started as a mission to save several emaciated dogs discovered in a local backyard has grown into a thriving non-profit sanctuary that now provides a safe haven for over 60 dogs at a time.</p>
        <p>We are dedicated to transforming lives through compassion and faith, ensuring that every animal in our care finds the love and dignity they deserve.</p>
        <a class="text-link" href="/mission">Read Our Story →</a>
      </div>
    </div>
  </section>

  <section class="give-home">
    <div class="container give-card">
      <div><p class="eyebrow inverse">Join our rescue pack</p><h2>Help us save the next one.</h2><p>Food, veterinary care, shelter, transportation, and daily care all add up. Your support gives rescued dogs the chance to heal and find home.</p></div>
      <a class="btn btn-light" href="/donate">Donate Today</a>
    </div>
  </section>
</BaseLayout>
<style>
.hero{position:relative;min-height:650px;display:flex;align-items:center;background-image:url('/images/Hero-dogs.jpg');background-size:cover;background-position:center;background-color:#b9aa99}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.78),rgba(0,0,0,.52) 42%,rgba(0,0,0,.12) 76%,rgba(0,0,0,.04))}
.hero-inner{position:relative;z-index:1;width:min(1200px,calc(100% - 48px));margin:auto;padding:76px 0}
.hero-copy{max-width:650px;color:#fff}
h1{margin:0;font-size:clamp(52px,6vw,86px);line-height:.98;letter-spacing:-3.5px}h1 span{color:#d92b33}
.hero-sub{margin:28px 0 0;font-size:21px;line-height:1.5}.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.light{color:#fff}
.dogs-home{padding:100px 0}.center-heading{max-width:760px;margin:0 auto 50px;text-align:center}.dogs-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.center-action{margin-top:38px;text-align:center}
.mission-home{padding:100px 0;background:#f3ece4}.mission-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px}.mission-copy{color:#4f4742;font-size:18px;line-height:1.75}.mission-copy p:first-child{margin-top:0}.text-link{display:inline-block;margin-top:12px;color:#c9252d;text-decoration:none;font-weight:800;text-transform:uppercase;font-size:13px;letter-spacing:.8px}
.give-home{padding:90px 0}.give-card{padding:54px;display:flex;align-items:center;justify-content:space-between;gap:40px;background:#c9252d;color:#fff;border-radius:28px}.give-card>div{max-width:760px}.give-card h2{margin:0;font-size:clamp(38px,4vw,58px);letter-spacing:-2px}.give-card p:not(.eyebrow){margin:18px 0 0;color:rgba(255,255,255,.85);font-size:18px;line-height:1.6}.inverse{color:#fff;opacity:.75}.btn-light{flex-shrink:0;background:#fff;color:#c9252d}
@media(max-width:900px){.dogs-grid{grid-template-columns:1fr 1fr}.mission-grid{grid-template-columns:1fr;gap:32px}.give-card{align-items:flex-start;flex-direction:column}}
@media(max-width:650px){.hero{min-height:590px;background-position:58% center}.hero-inner{width:min(1200px,calc(100% - 34px));padding:60px 0}h1{font-size:50px;letter-spacing:-2.5px}.dogs-grid{grid-template-columns:1fr}.dogs-home,.mission-home{padding:72px 0}.give-home{padding:70px 0}.give-card{padding:34px 26px}}
</style>
