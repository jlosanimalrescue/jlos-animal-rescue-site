---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Donate | J-Lo's Animal Rescue">
<section class="page-hero"><div class="container"><p class="eyebrow">Donate</p><h1 class="section-title">Help us save the next one.</h1><p class="section-copy">Your support helps provide food, veterinary treatment, shelter, supplies, transportation, and daily care for the dogs who need us.</p></div></section>
<section class="content-section"><div class="container card-grid"><article class="info-card"><h3>$25</h3><p>Helps with food, cleaning supplies, and routine sanctuary needs.</p></article><article class="info-card"><h3>$50</h3><p>Helps offset vaccines, medications, exams, and veterinary expenses.</p></article><article class="info-card"><h3>$100+</h3><p>Helps give the rescue flexibility for urgent cases and larger needs.</p></article></div><div class="container" style="margin-top:36px;text-align:center"><p style="color:#665d57">Replace this button with J-Lo's actual donation link.</p><a class="btn btn-primary" href="#">Donate Now</a></div></section>
</BaseLayout>
