---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Get Involved | J-Lo's Animal Rescue">
<section class="page-hero"><div class="container"><p class="eyebrow">Get Involved</p><h1 class="section-title">There is more than one way to save a life.</h1><p class="section-copy">Adopt, donate, volunteer, foster, share our dogs, or help with the everyday needs that keep the sanctuary running.</p></div></section>
<section class="content-section"><div class="container card-grid"><article class="info-card"><h3>Adopt</h3><p>Give a rescue dog the forever home they have been waiting for.</p></article><article class="info-card"><h3>Donate</h3><p>Help cover food, veterinary care, supplies, transport, and daily needs.</p></article><article class="info-card"><h3>Volunteer</h3><p>Give your time and skills to support the dogs and the work behind the scenes.</p></article><article class="info-card"><h3>Foster</h3><p>Provide a temporary home and help a dog learn what family life feels like.</p></article><article class="info-card"><h3>Share</h3><p>Sometimes one social post is what connects a dog to the right person.</p></article><article class="info-card"><h3>Partner</h3><p>Businesses and community groups can help through sponsorships and support.</p></article></div></section>
</BaseLayout>
