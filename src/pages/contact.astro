---
import BaseLayout from '../layouts/BaseLayout.astro';
const dog=Astro.url.searchParams.get('dog')??'';
---
<BaseLayout title="Contact | J-Lo's Animal Rescue">
<section class="page-hero"><div class="container"><p class="eyebrow">Contact</p><h1 class="section-title">Tell us how we can help.</h1><p class="section-copy">Interested in a dog, volunteering, donating, or learning more? Send us a message.</p></div></section>
<section class="content-section"><div class="container"><form class="form" name="contact" method="POST" data-netlify="true"><input type="hidden" name="form-name" value="contact"/><label>Name<input name="name" required/></label><label>Email<input name="email" type="email" required/></label><label>Dog name<input name="dog" value={dog} placeholder="Optional"/></label><label>Message<textarea name="message" required></textarea></label><button class="btn btn-primary" type="submit">Send Message</button></form></div></section>
</BaseLayout>
<style>.form{display:grid;gap:16px;max-width:760px}.form label{display:grid;gap:8px;font-size:14px;font-weight:700}.form input,.form textarea{width:100%;border:1px solid rgba(25,20,20,.18);background:#fff;border-radius:14px;padding:14px 15px;font:inherit}.form textarea{min-height:160px;resize:vertical}</style>
