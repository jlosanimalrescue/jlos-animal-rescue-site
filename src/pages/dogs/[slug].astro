---
import BaseLayout from '../../layouts/BaseLayout.astro';
import dogs from '../../data/dogs.json';
export function getStaticPaths(){return dogs.map(dog=>({params:{slug:dog.slug},props:{dog}}))}
const {dog}=Astro.props;
---
<BaseLayout title={`${dog.name} | J-Lo's Animal Rescue`}>
<section class="dog-detail"><div class="container detail-grid"><div class="photo"><img src={dog.image} alt={dog.name}/></div><div class="copy"><p class="eyebrow">{dog.status}</p><h1>{dog.name}</h1><p class="breed">{dog.breed}</p><div class="meta"><span>{dog.age}</span><span>{dog.sex}</span><span>{dog.size}</span></div><p class="description">{dog.description}</p><a class="btn btn-primary" href={`/contact?dog=${dog.slug}`}>Ask About {dog.name}</a></div></div></section>
</BaseLayout>
<style>.dog-detail{padding:80px 0 100px}.detail-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:60px;align-items:center}.photo{overflow:hidden;border-radius:28px;background:#e9e2da;aspect-ratio:4/3}.photo img{width:100%;height:100%;object-fit:cover}h1{margin:0;font-size:clamp(56px,7vw,88px);line-height:.95;letter-spacing:-4px}.breed{margin:12px 0 0;font-size:20px;color:#665e58}.meta{display:flex;gap:9px;flex-wrap:wrap;margin:26px 0}.meta span{padding:8px 11px;border-radius:999px;background:#f3ece4;font-size:13px;font-weight:700}.description{margin:0 0 30px;color:#514943;font-size:18px;line-height:1.75}@media(max-width:800px){.detail-grid{grid-template-columns:1fr;gap:34px}}</style>
