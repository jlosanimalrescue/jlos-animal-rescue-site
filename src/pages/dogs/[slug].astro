---
export function getStaticPaths() {
  const dogFiles = import.meta.glob('../../data/dogs/*.json', { eager: true });

  const dogs = Object.values(dogFiles).map((file: any) => file.default);

  return dogs.map((dog) => ({
    params: { slug: dog.slug },
    props: { dog }
  }));
}

const { dog } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{dog.name} | J-Lo's Animal Rescue & Sanctuary</title>
	</head>

	<body>
		<header>
			<a class="logo" href="/">
				<img src="/images/J-lo logo.png" alt="J-Lo's Animal Rescue & Sanctuary" />
			</a>

			<nav>
				<a href="/">Home</a>
				<a href="/adopt">Adopt</a>
				<a href="/#mission">Our Mission</a>
				<a href="/#involved">Get Involved</a>
				<a href="/#faq">FAQs</a>
				<a href="/#contact">Contact</a>
			</nav>

			<a class="donate" href="/#donate">♡ Donate</a>
		</header>

		<main>
			<section class="dog-profile">
				<div class="dog-photo">
					{dog.image ? (
						<img src={dog.image} alt={dog.name} />
					) : (
						<div class="placeholder">
							<span>Photo Coming Soon</span>
						</div>
					)}
				</div>

				<div class="dog-details">
					<p class="eyebrow">{dog.status}</p>

					<h1>{dog.name}</h1>

					<p class="breed">{dog.breed}</p>

					<div class="tags">
						<span>{dog.age}</span>
						<span>{dog.sex}</span>
						<span>{dog.size}</span>
					</div>

					<p class="description">
						{dog.description}
					</p>

					<a class="inquire-button" href={`/#contact`}>
						Inquire About {dog.name}
					</a>

					<a class="back-link" href="/adopt">
						← Back to All Dogs
					</a>
				</div>
			</section>
		</main>

		<footer>
			<img src="/images/J-lo logo.png" alt="J-Lo's Animal Rescue & Sanctuary" />

			<div>
				<p>Albany, Georgia</p>
				<p>From Neglected to Nourished. From Alone to Adored.</p>
			</div>

			<a href="/adopt">View All Dogs</a>
		</footer>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		font-family: Arial, Helvetica, sans-serif;
		background: #faf7f2;
		color: #191414;
	}

	header {
		min-height: 96px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 10px 5%;
		gap: 30px;
		background: #faf7f2;
	}

	.logo img {
		display: block;
		width: auto;
		height: 72px;
		max-width: 270px;
		object-fit: contain;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 30px;
	}

	nav a {
		color: #191414;
		text-decoration: none;
		font-size: 14px;
		font-weight: 700;
	}

	.donate {
		background: #c9252d;
		color: white;
		text-decoration: none;
		text-transform: uppercase;
		font-weight: 800;
		padding: 15px 24px;
		border-radius: 999px;
		white-space: nowrap;
	}

	.dog-profile {
		max-width: 1200px;
		margin: auto;
		padding: 80px 30px 110px;
		display: grid;
		grid-template-columns: 1.05fr .95fr;
		gap: 60px;
		align-items: center;
	}

	.dog-photo {
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: 28px;
		background: #e9e2da;
	}

	.dog-photo img {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
	}

	.placeholder {
		width: 100%;
		height: 100%;
		display: grid;
		place-items: center;
		color: #81766e;
		font-weight: 700;
	}

	.eyebrow {
		margin: 0 0 12px;
		color: #c9252d;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(58px, 7vw, 92px);
		line-height: .95;
		letter-spacing: -4px;
	}

	.breed {
		margin: 14px 0 0;
		font-size: 22px;
		color: #665d57;
	}

	.tags {
		display: flex;
		gap: 9px;
		flex-wrap: wrap;
		margin: 26px 0;
	}

	.tags span {
		padding: 8px 11px;
		background: #f3ece4;
		border-radius: 999px;
		font-size: 13px;
		font-weight: 700;
	}

	.description {
		margin: 0 0 30px;
		font-size: 18px;
		line-height: 1.75;
		color: #514943;
	}

	.inquire-button {
		display: inline-block;
		padding: 15px 24px;
		background: #c9252d;
		color: white;
		border-radius: 999px;
		text-decoration: none;
		text-transform: uppercase;
		font-size: 13px;
		font-weight: 800;
	}

	.back-link {
		display: block;
		margin-top: 20px;
		color: #665d57;
		text-decoration: none;
		font-size: 14px;
		font-weight: 700;
	}

	footer {
		padding: 50px 6%;
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		align-items: center;
		gap: 40px;
		background: #191414;
		color: white;
	}

	footer img {
		width: 220px;
		filter: brightness(0) invert(1);
	}

	footer p {
		color: rgba(255,255,255,.65);
	}

	footer > a {
		justify-self: end;
		color: white;
		text-decoration: none;
		font-weight: 700;
	}

	@media (max-width: 900px) {
		nav {
			display: none;
		}

		.dog-profile {
			grid-template-columns: 1fr;
			gap: 35px;
		}

		footer {
			grid-template-columns: 1fr;
		}

		footer > a {
			justify-self: start;
		}
	}

	@media (max-width: 650px) {
		header {
			padding: 10px 20px;
		}

		.logo img {
			height: 55px;
			max-width: 190px;
		}

		.donate {
			padding: 12px 16px;
			font-size: 12px;
		}

		.dog-profile {
			padding: 50px 20px 80px;
		}

		h1 {
			font-size: 58px;
			letter-spacing: -3px;
		}
	}
</style>