---
const { dog } = Astro.props;
---
<article class="dog-card">
  <a class="photo" href={`/dogs/${dog.slug}`}>
    <img src={dog.image} alt={dog.name} />
    {dog.featured && <span class="badge">Featured</span>}
  </a>
  <div class="body">
    <h3>{dog.name}</h3>
    <p class="breed">{dog.breed}</p>
    <div class="meta"><span>{dog.age}</span><span>{dog.sex}</span><span>{dog.size}</span></div>
    <p class="summary">{dog.summary}</p>
    <a class="learn" href={`/dogs/${dog.slug}`}>Meet {dog.name} →</a>
  </div>
</article>
<style>
.dog-card{overflow:hidden;background:#fff;border-radius:24px;border:1px solid rgba(25,20,20,.08);box-shadow:0 16px 45px rgba(34,24,21,.07)}
.photo{position:relative;display:block;aspect-ratio:4/3;overflow:hidden;background:#e9e2da}
.photo img{width:100%;height:100%;object-fit:cover}
.badge{position:absolute;top:16px;left:16px;padding:8px 12px;background:#c9252d;color:#fff;border-radius:999px;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.8px}
.body{padding:22px}
h3{margin:0;font-size:30px;letter-spacing:-1px}
.breed{margin:5px 0 0;color:#6b625c}
.meta{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0}
.meta span{padding:7px 10px;background:#f5efe8;border-radius:999px;font-size:12px;font-weight:700}
.summary{margin:0 0 18px;color:#625a54;line-height:1.6}
.learn{color:#c9252d;font-size:13px;font-weight:800;text-decoration:none;text-transform:uppercase;letter-spacing:.7px}
</style>
